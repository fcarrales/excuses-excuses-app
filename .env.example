# Public variables only — safe to expose in the browser bundle.
# Copy to .env.local and fill in your values. Do not commit .env.local.

NEXT_PUBLIC_APP_URL=https://x-qs.app
NEXT_PUBLIC_FEEDBACK_EMAIL=feedback@yourdomain.com

# Server-only (set in Vercel — never expose RESEND_API_KEY to the client)
# RESEND_API_KEY=re_xxxxxxxx
# FEEDBACK_TO_EMAIL=you@yourdomain.com
# FEEDBACK_FROM_EMAIL=Excuses Excuses <onboarding@resend.dev>
